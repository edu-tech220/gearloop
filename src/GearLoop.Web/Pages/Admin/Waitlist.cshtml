@page
@model GearLoop.Web.Pages.Admin.WaitlistModel
@{
    ViewData["Title"] = "Waitlist";
}

<h1>Waitlist</h1>
<p class="text-muted">Customers queued for equipment with no free capacity. Entries promote to a confirmed reservation automatically (FIFO) as capacity frees up.</p>

@if (!Model.Entries.Items.Any())
{
    <p>The waitlist is empty.</p>
}
else
{
    <table class="table">
        <thead>
            <tr><th>#</th><th>Customer</th><th>Equipment</th><th>Branch</th><th>Requested dates</th><th>Status</th><th>Requested at</th></tr>
        </thead>
        <tbody>
            @foreach (var w in Model.Entries.Items)
            {
                <tr>
                    <td>@w.Id</td>
                    <td>@w.CustomerName</td>
                    <td>@w.EquipmentModelName</td>
                    <td>@w.BranchName</td>
                    <td>@w.RequestedStart.ToString("d") &rarr; @w.RequestedEnd.ToString("d")</td>
                    <td><span class="badge bg-secondary">@w.Status</span></td>
                    <td>@w.CreatedAtUtc.ToString("g")</td>
                </tr>
            }
        </tbody>
    </table>
}
